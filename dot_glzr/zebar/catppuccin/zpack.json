{
  "$schema": "https://github.com/glzr-io/zebar/raw/v3.3.1/resources/zpack-schema.json",
  "name": "catppuccin",
  "version": "1.2.0",
  "description": "Catppuccin Macchiato top bar for GlazeWM with keyboard layout, audio and interactive popups.",
  "tags": ["topbar", "catppuccin", "glazewm"],
  "widgets": [
    {
      "name": "bar",
      "htmlPath": "./bar.html",
      "zOrder": "normal",
      "shownInTaskbar": false,
      "focused": false,
      "resizable": false,
      "transparent": true,
      "includeFiles": ["*.html", "*.css", "*.ps1"],
      "caching": {
        "defaultDuration": 604800,
        "rules": []
      },
      "privileges": {
        "shellCommands": [
          { "program": "powershell.exe", "argsRegex": ".*" }
        ]
      },
      "presets": [
        {
          "name": "default",
          "anchor": "top_left",
          "offsetX": "0px",
          "offsetY": "0px",
          "width": "100%",
          "height": "56px",
          "monitorSelection": {
            "type": "all"
          },
          "dockToEdge": {
            "enabled": false,
            "edge": null,
            "windowMargin": "0px"
          }
        }
      ]
    },
    {
      "name": "popup",
      "htmlPath": "./popup.html",
      "zOrder": "top_most",
      "shownInTaskbar": false,
      "focused": true,
      "resizable": false,
      "transparent": true,
      "includeFiles": ["*.html", "*.css", "*.ps1"],
      "caching": {
        "defaultDuration": 604800,
        "rules": []
      },
      "privileges": {
        "shellCommands": [
          { "program": "shutdown.exe", "argsRegex": ".*" },
          { "program": "rundll32.exe", "argsRegex": ".*" },
          { "program": "cmd.exe", "argsRegex": ".*" },
          { "program": "powershell.exe", "argsRegex": ".*" }
        ]
      },
      "presets": [
        {
          "name": "power",
          "anchor": "top_left",
          "offsetX": "8px",
          "offsetY": "56px",
          "width": "220px",
          "height": "210px",
          "monitorSelection": { "type": "primary" },
          "dockToEdge": { "enabled": false, "edge": null, "windowMargin": "0px" }
        },
        {
          "name": "calendar",
          "anchor": "top_center",
          "offsetX": "0px",
          "offsetY": "56px",
          "width": "320px",
          "height": "260px",
          "monitorSelection": { "type": "primary" },
          "dockToEdge": { "enabled": false, "edge": null, "windowMargin": "0px" }
        },
        {
          "name": "wifi",
          "anchor": "top_right",
          "offsetX": "-340px",
          "offsetY": "56px",
          "width": "320px",
          "height": "280px",
          "monitorSelection": { "type": "primary" },
          "dockToEdge": { "enabled": false, "edge": null, "windowMargin": "0px" }
        },
        {
          "name": "weather",
          "anchor": "top_right",
          "offsetX": "-20px",
          "offsetY": "56px",
          "width": "340px",
          "height": "200px",
          "monitorSelection": { "type": "primary" },
          "dockToEdge": { "enabled": false, "edge": null, "windowMargin": "0px" }
        },
        {
          "name": "systray",
          "anchor": "top_right",
          "offsetX": "-8px",
          "offsetY": "56px",
          "width": "380px",
          "height": "130px",
          "monitorSelection": { "type": "primary" },
          "dockToEdge": { "enabled": false, "edge": null, "windowMargin": "0px" }
        }
      ]
    }
  ]
}
